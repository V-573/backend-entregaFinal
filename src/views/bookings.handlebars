{{! <h1>Servicios disponibles</h1> }}
<h1>{{title}}</h1>

{{#if bookings.length}}
  {{#each bookings}}
    <article>
      <h2>{{clientName}}</h2>
      <p>{{clientEmail}}</p>
      <p>fecha: {{date}}</p>
      <p>hora: {{time}}</p>
      <!-- Enlace al detalle del servicio -->
      <a
        href="/bookings/{{_id}}"
        style="display: inline-block; margin-top: 8px;"
      >Ver detalle &rarr;</a>
    </article>
  {{/each}}
{{else}}
  <p>No hay servicios cargados</p>
{{/if}}